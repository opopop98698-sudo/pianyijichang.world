---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { generateWebsiteSchema, generateOrganizationSchema } from '../lib/structured-data';
import { siteSeoConfig } from '../config/seo';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  schema?: any;
  robots?: string;
  class?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  category?: string;
  tags?: string[];
  googleVerification?: string;
  bingVerification?: string;
  shenmaVerification?: string;
  baiduVerification?: string;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href.replace(/\/+$/, '/'),
  schema,
  robots = "index, follow",
  class: className = "",
  ogType = "website",
  ogImage = siteSeoConfig.defaultImage,
  publishedTime,
  modifiedTime,
  author = siteSeoConfig.defaultAuthor,
  category,
  tags,
  googleVerification = siteSeoConfig.verifications.google,
  bingVerification = siteSeoConfig.verifications.bing,
  shenmaVerification = siteSeoConfig.verifications.shenma,
  baiduVerification = siteSeoConfig.verifications.baidu
} = Astro.props;

// 确保 canonicalUrl 使用 https://pianyijichang.world 域名前缀与结尾斜杠
const siteOrigin = siteSeoConfig.siteOrigin;
const normalizedCanonical = canonicalUrl.startsWith("http")
  ? canonicalUrl
  : `${siteOrigin}${canonicalUrl.startsWith('/') ? '' : '/'}${canonicalUrl}`;

const defaultSchemas = [generateWebsiteSchema(), generateOrganizationSchema()];
const pageSchemas = schema
  ? (Array.isArray(schema) ? [...defaultSchemas, ...schema] : [...defaultSchemas, schema])
  : defaultSchemas;
---

<!doctype html>
<html lang="zh-CN" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={normalizedCanonical} />
    <link rel="icon" type="image/jpeg" href="/avatar.jpg" />
    <link rel="apple-touch-icon" href="/avatar.jpg" />

    <!-- 搜索引擎站长平台所有权安全验证 Meta (直接输出至静态 HTML 源码) -->
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    {shenmaVerification && <meta name="shenma-site-verification" content={shenmaVerification} />}
    {baiduVerification && <meta name="baidu-site-verification" content={baiduVerification} />}

    <!-- Open Graph / 社交元标签 -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={normalizedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="便宜机场" />
    <meta property="og:image" content={ogImage} />
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === "article" && author && <meta property="article:author" content={author} />}
    {ogType === "article" && category && <meta property="article:section" content={category} />}
    {ogType === "article" && tags && tags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter Card 元标签 -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={normalizedCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- KaTeX 数学公式样式与轻量渲染器 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" crossorigin="anonymous" />
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js" crossorigin="anonymous"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js" crossorigin="anonymous" onload="renderMathInElement(document.body, {delimiters: [{left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}]});"></script>

    <!-- 结构化数据 JSON-LD (同源数据直出) -->
    {pageSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- 全局样式加固：彻底杜绝任何 prose 或第三方样式污染导致的文字不可见与低对比度 -->
    <style is:global>
      /* 强制所有具有深色背景的按钮文字与图标必须为纯白且高对比度 */
      a.bg-blue-600,
      a.bg-blue-700,
      a.bg-slate-900,
      a.bg-indigo-600,
      button.bg-blue-600,
      button.bg-blue-700,
      [class*="bg-blue-600"].text-white,
      [class*="bg-blue-700"].text-white,
      [class*="bg-indigo-600"].text-white,
      [class*="bg-slate-900"].text-white,
      [class*="bg-slate-800"].text-white {
        color: #ffffff !important;
        text-decoration: none !important;
      }
      /* 确保按钮内的子元素文本与图标同样强制白色 */
      a.bg-blue-600 *,
      a.bg-blue-700 *,
      a.bg-slate-900 *,
      a.bg-indigo-600 *,
      button.bg-blue-600 *,
      button.bg-blue-700 * {
        color: inherit !important;
      }
      /* 移动端与桌面端通用链接平滑过渡 */
      a {
        -webkit-tap-highlight-color: transparent;
      }
      /* 卡片式链接彻底禁用段落和标签的下划线污染，保持现代应用卡片质感 */
      a.group,
      a.group p,
      a.group span,
      a.group h3,
      a.group h4,
      a.no-underline,
      a.no-underline * {
        text-decoration: none !important;
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col bg-slate-50 text-slate-900 font-sans antialiased selection:bg-blue-100 selection:text-blue-900">
    <Header />
    <main class={`flex-grow ${className}`} data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>
