---
import { getCollection } from 'astro:content';
import PillarLayout from '../layouts/PillarLayout.astro';

const allPages = await getCollection('pages');
const page = allPages.find((p) => p.slug === 'home' || p.data.id === 'page-home');
if (!page) {
  throw new Error('Could not find home page entry in pages collection');
}

const { Content } = await page.render();
---

<PillarLayout frontmatter={page.data}>
  <Content />
</PillarLayout>
