---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { generateBreadcrumbSchema, generateCollectionPageSchema } from '../../lib/structured-data';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '新手机场使用教程', url: '/tutorial/' }
];

const pageTitle = "新手机场使用教程：从订阅导入到故障排查全流程指南｜便宜机场";
const pageDescription = "零基础网络代理教学：涵盖通用订阅链接导入、Clash/Sing-box客户端安装、TUN 虚拟网卡排错、晚高峰卡顿优化与节点失效应急方案。";
const canonicalUrl = "/tutorial/";

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
const collectionSchema = generateCollectionPageSchema(
  pageTitle,
  pageDescription,
  canonicalUrl,
  [
    { name: "四步极速上手通用指引", url: `${canonicalUrl}#quick-start` },
    { name: "常见网络排错与排障手册", url: `${canonicalUrl}#troubleshooting` },
    { name: "DNS 泄漏与防追踪安全加固", url: `${canonicalUrl}#dns-leak` }
  ]
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  schema={[breadcrumbSchema, collectionSchema]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- 面包屑导航 -->
    <nav aria-label="Breadcrumb" class="mb-4 text-xs text-slate-500 flex items-center gap-1.5 flex-wrap">
      <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
      <span>/</span>
      <span class="text-slate-800 font-medium">使用教程</span>
    </nav>

    <!-- 栏目头部 H1 -->
    <div class="border-b border-slate-200 pb-8 mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 mb-3">
        <span class="w-2 h-2 rounded-full bg-blue-600"></span>
        新手入门与运维手册 · 客户端配置全流程
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        新手机场使用教程与网络故障排错实操专区
      </h1>
      <p class="text-base text-slate-600 leading-relaxed max-w-4xl m-0">
        无论您使用的是 Windows 电脑、MacBook、iPhone 还是安卓手机，网络代理的底层逻辑均围绕“获取订阅链接 → 导入规则客户端 → 选择适合节点 → 开启系统代理或 TUN 网卡”展开。本指南以清晰的工程步骤，带您 5 分钟内顺利完成配置并掌握核心排障技能。
      </p>
    </div>

    <!-- 四步快速上手指引 -->
    <section id="quick-start" class="my-10 bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
      <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
        <span class="w-2 h-6 bg-blue-600 rounded-full inline-block"></span>
        新手机场极速上手 4 步标准化流程
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
        <div class="p-5 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col justify-between">
          <div>
            <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center text-sm mb-3">1</span>
            <h3 class="text-base font-bold text-slate-900 mb-2">获取通用订阅链接</h3>
            <p class="text-xs text-slate-600 leading-relaxed">登录机场用户中心，在“仪表盘”找到“一键订阅”或“复制订阅链接”，优先选择 Clash 或通用订阅格式。</p>
          </div>
          <span class="mt-4 text-[11px] font-mono text-slate-400">避坑：切勿泄露订阅 Token</span>
        </div>

        <div class="p-5 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col justify-between">
          <div>
            <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center text-sm mb-3">2</span>
            <h3 class="text-base font-bold text-slate-900 mb-2">安装开源客户端</h3>
            <p class="text-xs text-slate-600 leading-relaxed">Windows/Mac 推荐 Clash Verge Rev，iOS 推荐 Shadowrocket，Android 推荐 Clash Meta for Android。</p>
          </div>
          <span class="mt-4 text-[11px] font-mono text-slate-400">建议从 GitHub 官方发布页下载</span>
        </div>

        <div class="p-5 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col justify-between">
          <div>
            <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center text-sm mb-3">3</span>
            <h3 class="text-base font-bold text-slate-900 mb-2">导入并更新配置</h3>
            <p class="text-xs text-slate-600 leading-relaxed">在客户端“配置/Profiles”页面粘贴链接并点击“保存并更新”，节点列表将自动下载并生成分流规则。</p>
          </div>
          <span class="mt-4 text-[11px] font-mono text-slate-400">网络超时建议勾选代理更新</span>
        </div>

        <div class="p-5 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col justify-between">
          <div>
            <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center text-sm mb-3">4</span>
            <h3 class="text-base font-bold text-slate-900 mb-2">选定节点与启动</h3>
            <p class="text-xs text-slate-600 leading-relaxed">推荐在“代理”组中手动指定香港或日本低倍率节点，随后开启“系统代理”开关，即可畅游全网。</p>
          </div>
          <span class="mt-4 text-[11px] font-mono text-slate-400">开启后访问国内外自动分流</span>
        </div>
      </div>
    </section>

    <!-- 常见故障排障手册 -->
    <section id="troubleshooting" class="my-10 bg-slate-50 rounded-3xl border border-slate-200 p-6 sm:p-8">
      <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center gap-2">
        <span class="w-2 h-5 bg-amber-500 rounded-full inline-block"></span>
        新手最常遭遇的 3 大连接故障排障清单
      </h2>

      <div class="space-y-3.5 text-xs">
        <div class="p-4 bg-white rounded-xl border border-slate-200 shadow-xs">
          <strong class="text-slate-900 block mb-1 text-sm font-bold">1. 状态显示绿色连接，但网页提示“无法连接到互联网”或 ERR_CONNECTION_RESET</strong>
          <p class="text-slate-600 m-0 leading-relaxed">
            <strong>解决方案</strong>：检查本地时间是否精确。由于现代 TLS 1.3 及 VMess/VLESS 依赖精准时间戳握手，若系统时钟误差超过 90 秒，服务器将直接丢弃请求。前往系统设置开启“自动同步时间”即可恢复。
          </p>
        </div>

        <div class="p-4 bg-white rounded-xl border border-slate-200 shadow-xs">
          <strong class="text-slate-900 block mb-1 text-sm font-bold">2. 国内网站打不开、银行 App 登录缓慢或提示异地登录</strong>
          <p class="text-slate-600 m-0 leading-relaxed">
            <strong>解决方案</strong>：确认客户端路由模式处于“Rule（规则分流）”模式，而不是“Global（全局模式）”。在规则模式下，淘宝、微信及所有中国大陆 IP 均直连访问，绝不消耗代理流量。
          </p>
        </div>

        <div class="p-4 bg-white rounded-xl border border-slate-200 shadow-xs">
          <strong class="text-slate-900 block mb-1 text-sm font-bold">3. 节点突然大面积出现“Timeout”测速超时</strong>
          <p class="text-slate-600 m-0 leading-relaxed">
            <strong>解决方案</strong>：首先检查套餐流量是否耗尽或到期；其次在客户端点击“更新订阅（Update）”拉取最新的节点域名。若持续超时，说明商户上游机房正在维护，建议启用备用月付机场。
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
