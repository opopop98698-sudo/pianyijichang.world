---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnswerBlock from '../../../components/AnswerBlock.astro';
import DecisionTree from '../../../components/DecisionTree.astro';
import contentMapData from '../../../data/content-map.json';
import { generateBreadcrumbSchema, generateCollectionPageSchema } from '../../../lib/structured-data';

export async function getStaticPaths() {
  const paths = [];
  for (const pillar of contentMapData) {
    for (const topic of pillar.topics) {
      paths.push({
        params: {
          pillar: pillar.id,
          topic: topic.id
        },
        props: {
          pillar,
          topic
        }
      });
    }
  }
  return paths;
}

const { pillar, topic } = Astro.props;

const canonicalUrl = `/topics/${pillar.id}/${topic.id}/`;
const pageTitle = `${topic.name}：核心指标口径、使用限制与选购决策指南｜便宜机场`;
const pageDescription = `关于${topic.name}的深度专题研究，包含计算标准、核心边界排查、两大下辖集群深度导读与下一步推荐决策。`;

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: pillar.name, url: `/${pillar.id}/` },
  { name: topic.name, url: canonicalUrl }
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
const collectionSchema = generateCollectionPageSchema(
  pageTitle,
  pageDescription,
  canonicalUrl,
  topic.clusters.map((c: any) => ({
    name: c.name,
    url: `${canonicalUrl}#cluster-${c.id}`
  }))
);

// 为每个专题生成高针对性的决策树与直接答案
const topicTree = `[ ${topic.name} 决策分流 ]
  │
  ├─ 关注集群 A: ${topic.clusters[0]?.name || "基础定义与核算口径"}
  │     └─ 解决是什么、怎么算与核心参数标准
  │
  └─ 关注集群 B: ${topic.clusters[1]?.name || "边界条件与实操比对"}
        └─ 解决什么时候不适用、有什么隐藏限制与实操对比`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  schema={[breadcrumbSchema, collectionSchema]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- 面包屑 -->
    <nav aria-label="Breadcrumb" class="mb-4 text-xs text-slate-500 flex items-center gap-1.5 flex-wrap">
      <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
      <span>/</span>
      <a href={`/${pillar.id}/`} class="hover:text-blue-600 transition-colors">{pillar.name}</a>
      <span>/</span>
      <span class="text-slate-800 font-medium">{topic.name}</span>
    </nav>

    <!-- 头部 H1 -->
    <div class="border-b border-slate-200 pb-6 mb-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
          二级深度专题
        </span>
        <span class="text-xs text-slate-500">
          归属柱石：{pillar.name}
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug mb-3">
        {topic.name}：核心指标口径、使用限制与选购指南
      </h1>
      <p class="text-slate-600 text-sm leading-relaxed m-0">
        本专题深入剖析【{topic.name}】的底层网络逻辑、实付核算依据与隐藏使用边界，下辖 {topic.clusters.length} 个核心集群，覆盖定义指标、条件限制与实操对比。
      </p>
    </div>

    <!-- 30秒直接答案 (Answer-First) -->
    <AnswerBlock
      question={`关于【${topic.name}】，用户最需要明确的核心事实是什么？`}
      answer={`在选购或配置与【${topic.name}】相关的代理服务时，首要原则是建立统一的度量口径并严查边界条件。严禁将理论峰值当作常态可用性，严禁忽视节点倍率与重置清零规则。必须以真实到手付款金额和高峰期实测连通率为准绳。`}
      highlight="口径统一、拒绝偷换概念、坚持单月低额验证"
    />

    <!-- ASCII 决策树 -->
    <DecisionTree
      title={`${topic.name} 逻辑推导与选购路径`}
      description="根据你的实际用网诉求，选择对应的下辖集群深入阅读："
      tree={topicTree}
    />

    <!-- 两大下辖集群深度展开与规划文章 -->
    <div class="my-10 space-y-8">
      <div class="flex items-center gap-2 border-b border-slate-200 pb-2">
        <span class="w-2 h-5 bg-blue-600 rounded-full"></span>
        <h2 class="text-lg font-bold text-slate-900 m-0">本专题下辖核心内容集群与研究成果</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {topic.clusters.map((cluster: any, idx: number) => (
          <div id={`cluster-${cluster.id}`} class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
              <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-blue-50 text-blue-700 font-mono">
                集群 0{idx + 1}
              </span>
              <span class="text-xs text-slate-400">已规划 3 篇三层文章</span>
            </div>

            <h3 class="text-base font-bold text-slate-900 mb-2">
              {cluster.name}
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-4">
              聚焦于【{cluster.name}】的具体业务痛点，从口径定义、条件限制与实操使用三个层次展开完整解答。
            </p>

            <div class="border-t border-slate-100 pt-3 space-y-2.5">
              {cluster.articles.map((art: any) => (
                <div class="text-xs">
                  <div class="flex items-baseline gap-1.5 mb-1">
                    <span class={`inline-block px-1.5 py-0.5 rounded text-[10px] font-semibold ${
                      art.type === 'definition' ? 'bg-blue-100 text-blue-800' :
                      art.type === 'condition' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'
                    }`}>
                      {art.type === 'definition' ? '口径' : art.type === 'condition' ? '边界' : '实操'}
                    </span>
                    <a href={`/articles/${art.slug}/`} class="font-medium text-slate-800 hover:text-blue-600 transition-colors line-clamp-1">
                      {art.title}
                    </a>
                  </div>
                  <p class="text-[11px] text-slate-400 pl-8 m-0 line-clamp-1">
                    核心意图：{art.primaryIntent}
                  </p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 底部返回与关联专题 -->
    <div class="mt-12 pt-6 border-t border-slate-200 flex items-center justify-between text-xs">
      <a href={`/${pillar.id}/`} class="text-blue-600 hover:underline flex items-center gap-1 font-semibold">
        ← 返回【{pillar.name}】上级主栏目
      </a>
      <a href="/cheap/" class="text-slate-600 hover:text-slate-900">
        查看全网便宜机场推荐清单 →
      </a>
    </div>
  </div>
</BaseLayout>
