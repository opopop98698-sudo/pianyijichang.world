---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnswerBlock from '../../components/AnswerBlock.astro';
import IntentConversionCard from '../../components/IntentConversionCard.astro';
import contentMapData from '../../data/content-map.json';
import { generateBreadcrumbSchema, generateArticleSchema, generateFaqSchema } from '../../lib/structured-data';
import { generateDeepContent } from '../../lib/deepseek-content-generator';

export async function getStaticPaths() {
  const paths = [];
  for (const pillar of contentMapData) {
    for (const topic of pillar.topics) {
      for (const cluster of topic.clusters) {
        for (const article of cluster.articles) {
          paths.push({
            params: {
              slug: article.slug
            },
            props: {
              article,
              cluster,
              topic,
              pillar,
              allClusterArticles: cluster.articles
            }
          });
        }
      }
    }
  }
  return paths;
}

const { article, cluster, topic, pillar, allClusterArticles } = Astro.props;

const canonicalUrl = `/articles/${article.slug}/`;
const pageTitle = `${article.title}｜便宜机场深度实测指南`;
const pageDescription = `针对【${article.primaryIntent}】的专业技术解构，涵盖底层网络协议原理、数学成本模型、四步验收操作与场景选购依据。`;

// 调用 DeepSeek-R1 深度内容推理生成引擎
const deepContent = generateDeepContent({
  title: article.title,
  slug: article.slug,
  type: article.type,
  primaryIntent: article.primaryIntent,
  pillarId: pillar.id,
  pillarName: pillar.name,
  topicId: topic.id,
  topicName: topic.name,
  clusterId: cluster.id,
  clusterName: cluster.name
});

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: pillar.name, url: `/${pillar.id}/` },
  { name: topic.name, url: `/topics/${pillar.id}/${topic.id}/` },
  { name: article.title, url: canonicalUrl }
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
const articleSchema = generateArticleSchema(
  article.title,
  pageDescription,
  canonicalUrl,
  "2026-10-20",
  "2026-10-20"
);
const faqSchema = generateFaqSchema(deepContent.faqList);

const typeLabel =
  article.type === 'definition' ? '口径/定义类（解决是什么/怎么算）' :
  article.type === 'condition' ? '条件/边界类（解决什么时候不适用/有什么限制）' :
  '对比/使用类（解决怎么用/怎么对比）';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  schema={[breadcrumbSchema, articleSchema, faqSchema]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- 顶部全景面包屑导航 (第 1 层内链拓扑) -->
    <nav aria-label="Breadcrumb" class="mb-4 text-xs text-slate-500 flex items-center gap-1.5 flex-wrap">
      <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
      <span>/</span>
      <a href={`/${pillar.id}/`} class="hover:text-blue-600 transition-colors">{pillar.name}</a>
      <span>/</span>
      <a href={`/topics/${pillar.id}/${topic.id}/`} class="hover:text-blue-600 transition-colors">{topic.name}</a>
      <span>/</span>
      <span class="text-slate-800 font-medium truncate max-w-xs">{article.title}</span>
    </nav>

    <!-- 文章头部元数据 -->
    <header class="border-b border-slate-200 pb-6 mb-8">
      <div class="flex items-center gap-2 mb-3 flex-wrap">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">
          {typeLabel}
        </span>
        <span class="text-xs text-slate-500">
          技术集群：{cluster.name}
        </span>
        <span class="text-xs text-slate-400 font-mono">
          核验基准：2026 年最新监测
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug mb-3">
        {article.title}
      </h1>

      <div class="bg-slate-100 rounded-xl p-3.5 text-xs text-slate-700 flex items-start gap-2 border border-slate-200">
        <span class="font-bold text-slate-900 shrink-0">搜索意图定向：</span>
        <span class="text-slate-600 leading-relaxed">{article.primaryIntent}</span>
      </div>
    </header>

    <!-- 首屏 Answer-First: 30 秒核心结论直接回答 -->
    <AnswerBlock
      question={article.title}
      answer={deepContent.executiveSummary}
      highlight="坚持统一标准、严查真实倍率、拒绝盲目长周期预付"
    />

    <!-- 针对性场景高转化推荐卡 (AI 意图算法匹配，高转化 CTA) -->
    <IntentConversionCard
      title={article.title}
      primaryIntent={article.primaryIntent}
      pillarId={pillar.id}
      topicId={topic.id}
    />

    <!-- DeepSeek-R1 硬核技术长文展开 -->
    <article class="prose prose-slate max-w-none text-slate-700 text-sm leading-relaxed space-y-8 my-8">
      <!-- 模块一：底层网络工程原理与协议剖析 -->
      <section>
        <h2 class="text-xl font-bold text-slate-900 border-b border-slate-200 pb-2 flex items-center gap-2">
          <span class="w-2 h-5 bg-blue-600 rounded-full inline-block"></span>
          一、问题背景与底层计算机网络工程原理
        </h2>
        <p>
          在讨论【<strong>{article.title}</strong>】这一问题时，绝不能停留在商户表层营销文案上。
          代理连接本质上是建立在端到端加密、传输层拥塞调度与多跳中继路由器（Hop-by-hop Router）转发之上的分布式网络应用。
          很多不良商户利用专业术语的不对称性（例如将公网直连伪称为全专线、将单线程限速隐瞒为服务器拥堵、用年付折算冒充真月付），导致用户实际体验与期望存在巨大鸿沟。
        </p>
        <div set:html={deepContent.deepTechnicalAnalysis} />
      </section>

      <!-- 模块二：严格量化数学模型与精算公式 (KaTeX 渲染) -->
      <section>
        <h2 class="text-xl font-bold text-slate-900 border-b border-slate-200 pb-2 flex items-center gap-2">
          <span class="w-2 h-5 bg-indigo-600 rounded-full inline-block"></span>
          二、决策量化数学模型与成本核算公式
        </h2>
        <p>
          为了帮助预算有限的中文用户消除主观臆断，本站引入三项严格的量化数学模型，供您在最终购买与验收时进行测算：
        </p>
        <div class="space-y-4 not-prose my-6">
          {deepContent.mathematicalModels.map((m) => (
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 sm:p-5">
              <h4 class="text-sm font-bold text-slate-900 mb-2">{m.title}</h4>
              <div class="bg-white p-3 rounded-xl border border-slate-200 text-center text-sm font-mono overflow-x-auto text-blue-900 my-2">
                $${m.formula}$$
              </div>
              <p class="text-xs text-slate-600 leading-relaxed m-0 mt-2">
                <strong>模型机理解析：</strong>{m.explanation}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- 模块三：量化对照基准表 (红线标准) -->
      <section>
        <h2 class="text-xl font-bold text-slate-900 border-b border-slate-200 pb-2 flex items-center gap-2">
          <span class="w-2 h-5 bg-emerald-600 rounded-full inline-block"></span>
          三、核心量化指标质量分级与避坑基准线
        </h2>
        <p>
          对照以下四维量化标准，可以迅速判断当前代理节点或所选套餐是否满足合格要求：
        </p>
        <div class="not-prose overflow-x-auto my-4">
          <table class="w-full text-left text-xs border border-slate-200 rounded-xl overflow-hidden shadow-sm">
            <thead class="bg-slate-900 text-white font-semibold">
              <tr>
                {deepContent.quantitativeMatrix.headers.map((h) => (
                  <th class="py-2.5 px-3">{h}</th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
              {deepContent.quantitativeMatrix.rows.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}>
                  <td class="py-2.5 px-3 font-semibold text-slate-900">{row[0]}</td>
                  <td class="py-2.5 px-3 text-emerald-700 font-medium bg-emerald-50/40">{row[1]}</td>
                  <td class="py-2.5 px-3 text-slate-600">{row[2]}</td>
                  <td class="py-2.5 px-3 text-rose-700 font-semibold bg-rose-50/40">{row[3]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- 模块四：科学实测与四步验收操作指南 -->
      <section>
        <h2 class="text-xl font-bold text-slate-900 border-b border-slate-200 pb-2 flex items-center gap-2">
          <span class="w-2 h-5 bg-amber-600 rounded-full inline-block"></span>
          四、科学实操实测与四步完整验收流程
        </h2>
        <div set:html={deepContent.practicalProtocol} />
      </section>

      <!-- 模块五：权威结论与行动建议 -->
      <section>
        <h2 class="text-xl font-bold text-slate-900 border-b border-slate-200 pb-2 flex items-center gap-2">
          <span class="w-2 h-5 bg-purple-600 rounded-full inline-block"></span>
          五、本站权威裁决与决策行动准则
        </h2>
        <p class="leading-relaxed">
          {deepContent.conversionVerdict}
        </p>
      </section>

      <!-- 模块六：常见高频技术 FAQ 问答 -->
      <section class="not-prose mt-8">
        <h3 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
          <span>❓ 关于【{article.title}】的常见高频疑问 (FAQ)</span>
        </h3>
        <div class="space-y-3">
          {deepContent.faqList.map((faq) => (
            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
              <h4 class="text-sm font-bold text-slate-900 m-0 mb-1.5 flex items-start gap-2">
                <span class="text-blue-600 font-mono">Q:</span>
                <span>{faq.question}</span>
              </h4>
              <p class="text-xs text-slate-600 leading-relaxed m-0 pl-5">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </section>
    </article>

    <!-- 全站 4 层高转化内链拓扑网络 (Internal Linking Mesh) -->
    <div class="my-10 space-y-6 not-prose">
      <!-- 层级 3: 同集群三层递进闭环文章 (口径定义 -> 边界限制 -> 实操对比) -->
      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-bold text-slate-900 m-0">
            所属集群【{cluster.name}】三层递进长尾实测：
          </h3>
          <span class="text-[11px] text-slate-400 font-mono">完整知识闭环</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {allClusterArticles.map((sibling: any) => (
            <a
              href={`/articles/${sibling.slug}/`}
              class={`p-3.5 rounded-xl border text-xs transition-all flex flex-col justify-between ${
                sibling.slug === article.slug
                  ? 'bg-blue-600 border-blue-600 !text-white font-bold shadow-sm'
                  : 'bg-white border-slate-200 text-slate-700 hover:border-blue-400 hover:shadow-sm'
              }`}
              style={sibling.slug === article.slug ? 'color: #ffffff !important; text-decoration: none !important;' : ''}
            >
              <span class={`line-clamp-2 mb-2 leading-snug ${sibling.slug === article.slug ? '!text-white font-bold' : ''}`} style={sibling.slug === article.slug ? 'color: #ffffff !important;' : ''}>
                {sibling.title}
              </span>
              <span class={`text-[10px] font-mono ${sibling.slug === article.slug ? '!text-blue-100 font-bold' : 'text-slate-400'}`} style={sibling.slug === article.slug ? 'color: #dbeafe !important;' : ''}>
                {sibling.type === 'definition' ? '[1.口径与定义]' : sibling.type === 'condition' ? '[2.适用边界]' : '[3.对比与操作]'}
              </span>
            </a>
          ))}
        </div>
      </div>

      <!-- 层级 4: 跨主栏目语义转化高速公路 (Semantic Highway Bridges) -->
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-100 rounded-2xl p-5">
        <h4 class="text-xs font-bold text-blue-900 uppercase tracking-wider mb-3">
          🚀 跨业务栏目高转化决策快速通道
        </h4>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs">
          <a
            href="/cheap/"
            class="bg-white/80 hover:bg-white p-2.5 rounded-xl border border-blue-200/60 text-slate-800 hover:text-blue-600 transition-colors font-medium flex flex-col justify-between"
          >
            <span>💰 便宜机场清单</span>
            <span class="text-[10px] text-slate-400 mt-1">查看 7-8 元真月付</span>
          </a>
          <a
            href="/plans/"
            class="bg-white/80 hover:bg-white p-2.5 rounded-xl border border-blue-200/60 text-slate-800 hover:text-blue-600 transition-colors font-medium flex flex-col justify-between"
          >
            <span>📦 流量套餐分档</span>
            <span class="text-[10px] text-slate-400 mt-1">50GB - 1TB+ 全案</span>
          </a>
          <a
            href="/monthly/"
            class="bg-white/80 hover:bg-white p-2.5 rounded-xl border border-blue-200/60 text-slate-800 hover:text-blue-600 transition-colors font-medium flex flex-col justify-between"
          >
            <span>🔄 真月付核验库</span>
            <span class="text-[10px] text-slate-400 mt-1">免预付绑架单月扣</span>
          </a>
          <a
            href="/recommend/#speedtest-evidence-vault"
            class="bg-white/80 hover:bg-white p-2.5 rounded-xl border border-blue-200/60 text-slate-800 hover:text-blue-600 transition-colors font-medium flex flex-col justify-between"
          >
            <span>⚡ 测速与解锁凭证</span>
            <span class="text-[10px] text-slate-400 mt-1">17 家节点实测原图</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 底部返回与双向导航 -->
    <div class="mt-8 pt-4 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500">
      <a href={`/topics/${pillar.id}/${topic.id}/`} class="text-blue-600 hover:underline flex items-center gap-1 font-medium">
        ← 返回所属【{topic.name}】二级专题
      </a>
      <a href="/" class="hover:text-slate-800 flex items-center gap-1">
        返回便宜机场资料库首页 →
      </a>
    </div>
  </div>
</BaseLayout>
