---
interface Props {
  field: string;
  notes?: string;
  class?: string;
}

const { field, notes, class: className = "" } = Astro.props;
---

<div class={`bg-red-50 border-l-4 border-red-500 rounded-r-xl p-3 my-3 text-xs text-red-800 ${className}`} role="alert">
  <div class="flex items-center gap-1.5 font-semibold text-red-900 mb-0.5">
    <svg class="w-4 h-4 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
    </svg>
    <span>数据透明度提示：【{field}】字段存在来源冲突</span>
  </div>
  <p class="m-0 text-red-700/90 leading-relaxed pl-5">
    该字段存在来源冲突，请以官网为准。{notes || "不同来源或测试时段数据存在差异，本站已做存疑标记，不进行单向静默覆盖。"}
  </p>
</div>
