---
const pathname = Astro.url.pathname;

const navItems = [
  { name: '首页', href: '/' },
  { name: '机场推荐', href: '/jichang/' },
  { name: '便宜机场', href: '/cheap/' },
  { name: '月付机场', href: '/monthly/' },
  { name: 'VPN专区', href: '/vpn/' },
  { name: 'Clash配置', href: '/clash/' },
  { name: '节点测速', href: '/nodes/' },
  { name: '梯子防坑', href: '/tizi/' },
  { name: '品牌库', href: '/brands/' }
];

const isActive = (href: string) => {
  if (href === '/' && pathname === '/') return true;
  if (href !== '/' && pathname.startsWith(href)) return true;
  return false;
};
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200">
  <!-- 顶部法定商业披露栏 -->
  <div class="bg-slate-900 text-slate-300 text-xs py-2 px-4 text-center">
    <div class="max-w-7xl mx-auto flex items-center justify-center gap-1.5 flex-wrap">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>独立第三方资料库：含推广链接，通过链接注册可能为本站带来佣金，不影响用户支付价格与中立核验原则。</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- 品牌 Logo 与头像 -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 group">
          <img
            src="/avatar.jpg"
            alt="便宜机场"
            class="w-10 h-10 rounded-xl object-cover shadow-sm group-hover:scale-105 transition-transform border border-slate-200"
            width="40"
            height="40"
          />
          <div class="flex flex-col">
            <span class="font-extrabold text-slate-900 text-xl leading-tight tracking-tight group-hover:text-blue-600 transition-colors">
              便宜机场
            </span>
            <span class="text-xs text-slate-400 font-mono leading-none mt-0.5">
              pianyijichang.world
            </span>
          </div>
        </a>
      </div>

      <!-- 桌面端 9 个固定一级导航 (字号由 12px 放大至 15px 粗体，间距与内边距适度舒展) -->
      <nav class="hidden xl:flex items-center space-x-1.5" aria-label="全站导航">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`px-3.5 py-2 rounded-xl text-[15px] font-bold transition-all ${
              isActive(item.href)
                ? 'bg-blue-50 text-blue-700 font-extrabold border border-blue-200/80 shadow-xs'
                : 'text-slate-700 hover:text-blue-600 hover:bg-blue-50/60'
            }`}
          >
            {item.name}
          </a>
        ))}
      </nav>

      <!-- 搜索与关于入口 -->
      <div class="flex items-center gap-2.5">
        <a
          href="/search/"
          class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 hover:text-slate-900 rounded-xl transition-colors flex items-center gap-1.5 text-sm font-semibold"
          title="搜索全站资源与知识库"
          aria-label="搜索全站资源"
        >
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <span class="hidden sm:inline">搜索</span>
        </a>

        <!-- 移动端菜单折叠按钮 (原生 checkbox 纯 CSS 驱动，确保禁用 JS 仍可唤出) -->
        <label for="mobile-menu-toggle" class="xl:hidden p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg cursor-pointer">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <span class="sr-only">展开导航菜单</span>
        </label>
      </div>
    </div>
  </div>

  <!-- 纯 CSS 控制的无 JS 降级移动菜单 -->
  <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" />
  <div class="hidden peer-checked:block xl:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-1 shadow-lg">
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 py-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`px-3 py-2.5 rounded-xl text-sm font-bold text-center transition-colors ${
            isActive(item.href)
              ? 'bg-blue-600 !text-white font-bold shadow-sm'
              : 'bg-slate-50 text-slate-700 hover:bg-slate-100'
          }`}
          style={isActive(item.href) ? 'color: #ffffff !important;' : ''}
        >
          {item.name}
        </a>
      ))}
      <a href="/free/" class="px-3 py-2.5 rounded-xl text-sm font-bold text-center bg-slate-50 text-slate-700 hover:bg-slate-100">
        免费资源
      </a>
      <a href="/tutorial/" class="px-3 py-2.5 rounded-xl text-sm font-bold text-center bg-slate-50 text-slate-700 hover:bg-slate-100">
        使用教程
      </a>
      <a href="/plans/" class="px-3 py-2.5 rounded-xl text-sm font-bold text-center bg-slate-50 text-slate-700 hover:bg-slate-100">
        流量套餐
      </a>
    </div>
    <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs sm:text-sm text-slate-500">
      <a href="/about/" class="text-blue-600 hover:underline">关于本站与独立声明</a>
      <a href="/search/" class="text-slate-600 hover:underline">站内全文检索</a>
    </div>
  </div>
</header>
