---
interface Props {
  question: string;
  answer: string;
  highlight?: string;
  class?: string;
}

const { question, answer, highlight, class: className = "" } = Astro.props;
---

<div class={`bg-gradient-to-br from-blue-50/80 to-indigo-50/40 border border-blue-200/80 rounded-2xl p-5 sm:p-6 my-6 shadow-sm ${className}`}>
  <div class="flex items-center gap-2 mb-2 text-blue-800 font-semibold text-xs uppercase tracking-wider">
    <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-blue-600 text-white text-[10px] font-bold">
      答
    </span>
    <span>30秒直接答案 (Answer-First)</span>
  </div>
  
  <h2 class="text-base sm:text-lg font-bold text-slate-900 mb-2 leading-snug">
    {question}
  </h2>

  <div class="text-slate-700 text-sm leading-relaxed mb-3">
    {answer}
  </div>

  {highlight && (
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/80 border border-blue-200 text-xs font-medium text-blue-900">
      <span class="text-blue-600 font-bold">核心判定依据：</span>
      <span>{highlight}</span>
    </div>
  )}
</div>
