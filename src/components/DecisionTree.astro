---
interface Props {
  tree: string;
  title?: string;
  description?: string;
  class?: string;
}

const {
  tree,
  title = "选购逻辑与决策路径树 (ASCII Decision Tree)",
  description = "根据预算、设备数量与使用频率的快速分支推演：",
  class: className = ""
} = Astro.props;
---

<div class={`my-6 rounded-2xl border border-slate-200 bg-slate-900 text-slate-100 p-5 shadow-inner ${className}`}>
  <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-3">
    <div class="flex items-center gap-2">
      <div class="flex gap-1.5">
        <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
      </div>
      <span class="text-xs font-semibold text-slate-300 ml-2">{title}</span>
    </div>
    <span class="text-[11px] text-slate-500 font-mono">decision-tree.txt</span>
  </div>

  {description && (
    <p class="text-xs text-slate-400 mb-3 m-0">{description}</p>
  )}

  <pre class="font-mono text-xs sm:text-[13px] leading-relaxed text-emerald-400 overflow-x-auto p-2 bg-slate-950/60 rounded-xl whitespace-pre m-0 border border-slate-800">{tree}</pre>
  
  <div class="mt-3 text-[11px] text-slate-500 flex items-center justify-between">
    <span>* 箭头代表条件推导分支，终端节点代表推荐方案</span>
    <span>纯文本渲染，支持无JS环境阅读</span>
  </div>
</div>
