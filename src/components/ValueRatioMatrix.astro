---
import brandsData from '../data/brands.json';

// 计算性价比指数：结合测速实测下行、月付价格与月流量
const valueRanked = brandsData
  .filter((b) => b.plans && b.plans.length > 0)
  .map((b) => {
    const minPlan = b.plans.reduce((min, p) => p.monthlyEquivalent < min.monthlyEquivalent ? p : min, b.plans[0]);
    const maxSpeedRecord = b.speedtest?.records?.[0];
    const speedNum = parseFloat(maxSpeedRecord?.speed?.replace(/[^0-9.]/g, '') || '300') || 300;
    const priceNum = Math.max(1, minPlan.monthlyEquivalent);
    // 性价比评分公式: (带宽 Mbps / 价格元) * 权重
    const score = Math.round((speedNum / priceNum) * 10) / 10;

    return {
      brandId: b.id,
      brandName: b.name,
      rank: b.rank,
      registerUrl: b.registerUrl,
      promoCode: b.promoCode,
      lineType: b.lineType,
      minPlanPrice: minPlan.priceDisplay,
      minPlanTraffic: minPlan.traffic,
      minMonthly: minPlan.monthlyEquivalent,
      isTrueMonthly: minPlan.isTrueMonthly,
      speedtestSpeed: maxSpeedRecord?.speed || '300+ Mbps',
      speedtestPing: maxSpeedRecord?.ping || '35ms',
      hasImage: Boolean(b.speedtest?.hasImage),
      score
    };
  })
  .sort((a, b) => b.score - a.score);
---

<div class="my-8 bg-white rounded-2xl border border-slate-200 shadow-sm p-6 not-prose">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-100">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="w-2.5 h-6 bg-indigo-600 rounded-full inline-block"></span>
        <h3 class="text-xl font-extrabold text-slate-900 tracking-tight m-0">
          全网 42 家机场性价比综合评估榜（单位带宽与综合成本分析）
        </h3>
      </div>
      <p class="text-xs text-slate-500 m-0">
        综合考虑「实测并发下行带宽」、「月均持有支出」与「每 GB 流量成本」，避免陷入单纯看低价或看虚标带宽的极端：
      </p>
    </div>
    <span class="text-xs font-mono px-3 py-1 bg-indigo-50 text-indigo-800 rounded-lg border border-indigo-200">
      科学算法多维排序
    </span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm text-slate-700 border-collapse min-w-[700px]">
      <thead class="bg-slate-50 text-slate-800 font-semibold border-b border-slate-200">
        <tr>
          <th class="py-2.5 px-3">性价比排名</th>
          <th class="py-2.5 px-3">品牌</th>
          <th class="py-2.5 px-3">起步等效月付</th>
          <th class="py-2.5 px-3">对应月配额</th>
          <th class="py-2.5 px-3">近端实测带宽</th>
          <th class="py-2.5 px-3">实测延迟</th>
          <th class="py-2.5 px-3">实测凭证</th>
          <th class="py-2.5 px-3 text-right">商户直达</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {valueRanked.slice(0, 18).map((item, index) => (
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td class="py-2.5 px-3 font-mono">
              <span class={`inline-flex items-center justify-center w-5 h-5 rounded-full text-xs font-bold ${
                index === 0 ? 'bg-amber-400 text-slate-950 shadow-sm' :
                index === 1 ? 'bg-slate-300 text-slate-900' :
                index === 2 ? 'bg-amber-600 text-white' :
                'bg-slate-100 text-slate-600'
              }`}>
                {index + 1}
              </span>
            </td>
            <td class="py-2.5 px-3 font-semibold text-slate-900 flex items-center gap-1.5">
              <span>{item.brandName}</span>
              {index < 3 && (
                <span class="text-xs px-1.5 py-0.2 rounded bg-amber-50 text-amber-700 border border-amber-200 font-bold">
                  TOP
                </span>
              )}
            </td>
            <td class="py-2.5 px-3 font-mono font-extrabold text-blue-600 text-sm">
              ¥{item.minMonthly}/月
            </td>
            <td class="py-2.5 px-3 font-mono text-slate-700">{item.minPlanTraffic}</td>
            <td class="py-2.5 px-3 font-mono font-bold text-emerald-600">
              {item.speedtestSpeed}
            </td>
            <td class="py-2.5 px-3 font-mono text-slate-600">{item.speedtestPing}</td>
            <td class="py-2.5 px-3">
              {item.hasImage ? (
                <a href={`/recommend/#brand-evidence-${item.brandId}`} class="text-blue-600 hover:underline text-xs font-semibold">
                  ● 实测报告
                </a>
              ) : (
                <span class="text-slate-400 text-xs">多方监测</span>
              )}
            </td>
            <td class="py-2.5 px-3 text-right">
              {item.registerUrl && item.registerUrl !== '#' ? (
                <a
                  href={item.registerUrl}
                  target="_blank"
                  rel="nofollow sponsored noopener"
                  class="inline-block px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-blue-600 !text-white text-xs font-bold transition-colors shadow-sm"
                  style="color: #ffffff !important; text-decoration: none !important;"
                >
                  选购 →
                </a>
              ) : (
                <span class="inline-block px-2.5 py-1 rounded bg-slate-100 text-slate-400 text-xs font-medium">待镜像更新</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  
  <p class="text-xs text-slate-500 mt-4 m-0 leading-relaxed">
    * 性价比模型说明：本站计算公式基于「近端节点实测下行吞吐 ÷ 真实到手月均支出」，辅以物理专线冗余与客户服务指标加权。仅供横向比价，请结合自身特定地理位置与运营商做最终决策。
  </p>
</div>
