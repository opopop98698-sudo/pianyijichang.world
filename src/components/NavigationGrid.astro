---

<div class="my-10 not-prose">
  <div class="flex items-center justify-between mb-6">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="w-2.5 h-6 bg-blue-600 rounded-full inline-block"></span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight m-0">
          八大核心选购路径与意图导航
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-slate-500 m-0">
        根据你的核心诉求与预算约束，点击直达对应维度的专业核验专栏：
      </p>
    </div>
    <span class="hidden md:inline-block text-xs font-mono text-slate-400 bg-slate-100 px-2.5 py-1 rounded-lg border border-slate-200">
      8条独立决策树
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    {paths.map((p) => (
      <a
        href={p.href}
        class="group relative bg-white rounded-2xl border border-slate-200/90 p-5 shadow-sm hover:shadow-md hover:border-blue-400 hover:-translate-y-0.5 transition-all duration-200 flex flex-col justify-between"
      >
        <div>
          <!-- 痛点提问 -->
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-xs font-bold text-blue-600 group-hover:text-blue-700 transition-colors">
              {p.painpoint}
            </span>
          </div>

          <!-- 栏目标题与徽章 -->
          <div class="flex items-center justify-between gap-2 mb-2">
            <div class="flex items-center gap-2">
              <span class="w-8 h-8 rounded-xl bg-slate-100 group-hover:bg-blue-50 text-slate-700 group-hover:text-blue-600 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={p.icon}></path>
                </svg>
              </span>
              <h3 class="text-base font-extrabold text-slate-900 m-0 group-hover:text-blue-600 transition-colors">
                {p.title}
              </h3>
            </div>
            <span class={`text-[10px] font-semibold px-2 py-0.5 rounded-full border ${p.tagColor}`}>
              {p.tag}
            </span>
          </div>

          <!-- 核心导读 -->
          <p class="text-xs text-slate-600 leading-relaxed mt-2 mb-3">
            {p.description}
          </p>

          <!-- 指标小标签 -->
          <div class="flex flex-wrap gap-1.5 mb-4">
            {p.metrics.map((m) => (
              <span class="text-[10px] font-mono text-slate-500 bg-slate-50 border border-slate-200 px-1.5 py-0.5 rounded">
                #{m}
              </span>
            ))}
          </div>
        </div>

        <!-- 底部进入箭头 -->
        <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-slate-700 group-hover:text-blue-600 transition-colors">
          <span>进入专栏选购</span>
          <span class="transform group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>
    ))}
  </div>
</div>
