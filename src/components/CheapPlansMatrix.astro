---
import brandsData from '../data/brands.json';

// 收集所有折合月付低于等于 15 元的套餐
const cheapPlans: Array<{
  brandId: string;
  brandName: string;
  rank: number;
  registerUrl: string;
  promoCode?: string;
  planName: string;
  billing: string;
  priceDisplay: string;
  traffic: string;
  monthlyEquivalent: number;
  isTrueMonthly: boolean;
  hasSpeedtest: boolean;
}> = [];

for (const b of brandsData) {
  for (const p of b.plans || []) {
    if (p.monthlyEquivalent <= 15) {
      cheapPlans.push({
        brandId: b.id,
        brandName: b.name,
        rank: b.rank,
        registerUrl: b.registerUrl,
        promoCode: b.promoCode,
        planName: p.name,
        billing: p.billing,
        priceDisplay: p.priceDisplay,
        traffic: p.traffic,
        monthlyEquivalent: p.monthlyEquivalent,
        isTrueMonthly: p.isTrueMonthly,
        hasSpeedtest: Boolean(b.speedtest?.hasImage)
      });
    }
  }
}

// 升序排列
cheapPlans.sort((a, b) => a.monthlyEquivalent - b.monthlyEquivalent);
---

<div class="my-8 bg-white rounded-2xl border border-slate-200 shadow-sm p-6 not-prose">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-100">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="w-2.5 h-6 bg-emerald-600 rounded-full inline-block"></span>
        <h3 class="text-xl font-extrabold text-slate-900 tracking-tight m-0">
          全网 42 家机场低价套餐全景矩阵（≤15 元/月筛选）
        </h3>
      </div>
      <p class="text-xs text-slate-500 m-0">
        已自动清洗并严格隔离「真月付单月扣款」与「年付折算均摊」，杜绝被标题党虚假价格误导：
      </p>
    </div>
    <span class="text-xs font-mono px-3 py-1 bg-emerald-50 text-emerald-800 rounded-lg border border-emerald-200">
      已索引 {cheapPlans.length} 档低价套餐
    </span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs text-slate-600 border-collapse min-w-[680px]">
      <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
        <tr>
          <th class="py-2.5 px-3">品牌</th>
          <th class="py-2.5 px-3">套餐名称</th>
          <th class="py-2.5 px-3">计费方式</th>
          <th class="py-2.5 px-3">实际总付款</th>
          <th class="py-2.5 px-3">每月配额</th>
          <th class="py-2.5 px-3">等效月付</th>
          <th class="py-2.5 px-3">扣款属性</th>
          <th class="py-2.5 px-3">测速状态</th>
          <th class="py-2.5 px-3 text-right">商户入口</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {cheapPlans.map((item) => (
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td class="py-2.5 px-3 font-semibold text-slate-900 flex items-center gap-1.5">
              <span class="text-slate-400 font-mono text-xs">#{item.rank}</span>
              <span class="font-bold">{item.brandName}</span>
            </td>
            <td class="py-2.5 px-3 font-medium text-slate-800">{item.planName}</td>
            <td class="py-2.5 px-3">
              <span class={`px-2 py-0.5 rounded text-xs font-semibold ${
                item.isTrueMonthly ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-slate-100 text-slate-600'
              }`}>
                {item.billing}
              </span>
            </td>
            <td class="py-2.5 px-3 font-mono font-bold text-slate-900">{item.priceDisplay}</td>
            <td class="py-2.5 px-3 font-mono text-slate-700">{item.traffic}</td>
            <td class="py-2.5 px-3 font-mono font-extrabold text-blue-600 text-sm">
              ¥{item.monthlyEquivalent} <span class="text-xs text-slate-400 font-normal">/月</span>
            </td>
            <td class="py-2.5 px-3">
              {item.isTrueMonthly ? (
                <span class="inline-block px-2 py-0.5 rounded text-xs bg-emerald-100 text-emerald-800 font-semibold">
                  真月付
                </span>
              ) : (
                <span class="inline-block px-2 py-0.5 rounded text-xs bg-amber-50 text-amber-700 border border-amber-200">
                  长周期折算
                </span>
              )}
            </td>
            <td class="py-2.5 px-3 font-mono text-xs">
              {item.hasSpeedtest ? (
                <a href={`/recommend/#brand-evidence-${item.brandId}`} class="text-emerald-600 hover:underline font-semibold">
                  ● 查看测速图
                </a>
              ) : (
                <span class="text-slate-400">待补充实测</span>
              )}
            </td>
            <td class="py-2.5 px-3 text-right">
              <a
                href={item.registerUrl}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="inline-block px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 !text-white font-bold text-xs transition-colors shadow-sm"
                style="color: #ffffff !important; text-decoration: none !important;"
              >
                选购 →
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  
  <p class="text-xs text-slate-500 mt-4 m-0 leading-relaxed">
    * 选购提醒：标有「真月付」的套餐支持单月续费，无预付一年风险；标有「长周期折算」的套餐需要一次性支付整年费用方可享受均摊价。含推广链接，请根据自身预算按需选购。
  </p>
</div>
